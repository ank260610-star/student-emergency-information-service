# Cloudflare Worker required secret
# Obtain this from AMap Console → Applications → My Applications → Web Service.
AMAP_WEB_SERVICE_KEY=replace_with_your_amap_web_service_key

# The following Cloudflare bindings are declared in wrangler.jsonc and are
# created or attached during deployment. Do not add values for them here.
# ASSETS
# VISIT_COUNTER

# Note: NK_GENIOS_AGENT_API_URL and NK_GENIOS_AGENT_TOKEN may still appear in
# Cloudflare's existing secret list, but the current Worker code does not read
# either variable. They are not required for the current deployment.
