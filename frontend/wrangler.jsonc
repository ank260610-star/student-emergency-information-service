{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "student-emergency-information-service",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "azk.fallaxaura.dpdns.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
